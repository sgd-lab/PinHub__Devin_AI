# Supabase (required for login + persistent personalization)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-side AES-256-GCM secret for encrypting user-provided AI provider API keys.
# Generate once with: openssl rand -base64 32
# IMPORTANT: server-only — must NOT be prefixed with NEXT_PUBLIC_*.
PINHUB_KEY_ENC_SECRET=base64-of-32-random-bytes
